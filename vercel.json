{
  "framework": null,
  "installCommand": "",
  "buildCommand": "node scripts/inject-supabase.js && mkdir -p public && cp index.html public/index.html",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
    }
  ]
}
